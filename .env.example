# Database
# Example:
# DATABASE_URL=postgresql://qms_user:changeme@localhost:5432/qms
DATABASE_URL=

# Encryption Keys (AES-256, 32 bytes each, base64/urlsafe-base64 strings)
# Example generation:
# python -c "import secrets; [print(f'ENCRYPTION_KEY_LEVEL_{i}={secrets.token_urlsafe(32)}') for i in range(1,4)]"
ENCRYPTION_KEY_LEVEL_1=
ENCRYPTION_KEY_LEVEL_2=
ENCRYPTION_KEY_LEVEL_3=

# JWT Authentication (RS256 public key from external IdP)
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
# Optional claim validation
JWT_AUDIENCE=
JWT_ISSUER=

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Optional database tuning (defaults in src/utils/config.py)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false
